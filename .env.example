# Frontend (Vite) configuration. Copy to .env.local if you need to change something.
# Empty values mean "same origin": in development Vite proxies /api and /socket.io to the server.

# Base URL of the REST API (e.g. https://api.example.com). Empty = same origin.
VITE_API_BASE_URL=
# Socket.IO server URL. Empty = same origin.
VITE_SOCKET_URL=
# Origin encoded in the pairing QR. `npm run dev:lan` sets it automatically to https://<LAN-IP>:5173.
VITE_PUBLIC_ORIGIN=
# Default UI language: es | en
VITE_DEFAULT_LOCALE=es
# Speech recognition language.
VITE_SPEECH_LANG=es-CO
# Where Vite proxies /api and /socket.io in development.
FLUX_API_PROXY_TARGET=http://localhost:3001
