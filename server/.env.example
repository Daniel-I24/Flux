# FLUX server configuration. Copy to server/.env for local runs (never commit the real file).
# In Render, set these as environment variables of the service.

PORT=3001

# Browser origins allowed by CORS (comma-separated). The Android apps send no Origin header.
CORS_ORIGINS=

# Google Gemini. Without a key /api/classify answers 503 and the apps classify locally.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=7500

# Firebase Admin: verifies the users' ID tokens and App Check tokens.
# FIREBASE_SERVICE_ACCOUNT_BASE64 = base64 of the service-account JSON (Project settings > Service accounts).
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Require a valid App Check token (recommended in production).
APP_CHECK_REQUIRED=false

# Rate limits per window.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_PER_USER=30
RATE_LIMIT_PER_IP=120

# Maximum JSON body size.
BODY_LIMIT=16kb
