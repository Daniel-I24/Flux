# FLUX server configuration. Copy to server/.env (never commit the real file).

# Port of the Express + Socket.IO server (Vite proxies /api and /socket.io here).
PORT=3001

# Comma-separated list of browser origins allowed by CORS and Socket.IO.
CORS_ORIGINS=http://localhost:5173,https://localhost:5173

# Google Gemini. Leave GEMINI_API_KEY empty to use only the local classifier.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=6000

# Rate limiting for /api (requests per window per IP).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Maximum JSON body size.
BODY_LIMIT=10kb
