{
  "name": "flux-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,server -c cyan,magenta \"npm run dev:web\" \"npm run dev:server\"",
    "dev:web": "vite",
    "dev:server": "npm --prefix server run dev",
    "dev:lan": "node scripts/dev-lan.mjs",
    "setup": "npm install && npm --prefix server install",
    "build": "npm run build:web && npm run build:server",
    "build:web": "tsc && vite build",
    "build:server": "npm --prefix server run build",
    "preview": "vite preview",
    "test": "vitest run && npm --prefix server test",
    "test:web": "vitest run",
    "test:server": "npm --prefix server test",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\" \"server/src/**/*.ts\" vite.config.ts",
    "lint:fix": "eslint \"src/**/*.ts\" \"server/src/**/*.ts\" vite.config.ts --fix",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"server/src/**/*.ts\"",
    "icons": "node scripts/generate-icons.mjs",
    "emulator": "powershell -ExecutionPolicy Bypass -File scripts/emulator.ps1",
    "usb": "powershell -ExecutionPolicy Bypass -File scripts/emulator.ps1 -Usb"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide": "^0.475.0",
    "qrcode": "^1.5.4",
    "socket.io-client": "^4.8.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.6",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "happy-dom": "^21.0.3",
    "postcss": "^8.4.40",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^2.1.3"
  }
}
