{
  "root": true,
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": ["@typescript-eslint"],
  "extends": ["eslint:recommended", "plugin:@typescript-eslint/recommended", "prettier"],
  "ignorePatterns": ["dist", "dev-dist", "node_modules", "server/dist", "coverage"],
  "rules": {
    "@typescript-eslint/no-explicit-any": "error",
    "@typescript-eslint/no-non-null-assertion": "error",
    "@typescript-eslint/no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }
    ],
    "no-console": "error",
    "no-restricted-properties": [
      "error",
      { "property": "innerHTML", "message": "Build DOM nodes with textContent instead." },
      { "property": "outerHTML", "message": "Build DOM nodes with textContent instead." }
    ]
  },
  "overrides": [
    {
      "files": ["src/core/logger/**/*.ts", "server/src/config/logger.ts", "scripts/**/*.ts"],
      "rules": { "no-console": "off" }
    }
  ]
}
